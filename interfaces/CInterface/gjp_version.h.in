/**
 * GaussJacobiQuad version.
 *
 * Generated by meson from the project version. Do not edit.
 */
#ifndef GJP_VERSION_H
#define GJP_VERSION_H

#define GJP_VERSION_MAJOR @GJP_VERSION_MAJOR@
#define GJP_VERSION_MINOR @GJP_VERSION_MINOR@
#define GJP_VERSION_PATCH @GJP_VERSION_PATCH@

/** Project version string. */
#define GJP_VERSION_STRING "@GJP_VERSION_STRING@"

/** Combined integer: 10000 * major + 100 * minor + patch. */
#define GJP_VERSION (10000 * GJP_VERSION_MAJOR + 100 * GJP_VERSION_MINOR + GJP_VERSION_PATCH)

#endif /* GJP_VERSION_H */
